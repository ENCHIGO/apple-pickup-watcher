{
  "manifest_version": 3,
  "name": "Apple Pickup Watcher 自动结账助手",
  "version": "0.1.0",
  "description": "只在 Apple 官方商店中，把库存命中的精确型号推进到付款前；不会填写账号、验证码或支付信息，也不会点击最终下单。",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.apple.com.cn/shop/*",
    "https://www.apple.com/hk-zh/shop/*",
    "https://www.apple.com/tw/shop/*",
    "https://www.apple.com/jp/shop/*",
    "https://www.apple.com/sg/shop/*",
    "https://www.apple.com/au/shop/*",
    "https://www.apple.com/my/shop/*",
    "https://*.store.apple.com/*",
    "https://*.store.apple.com.cn/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.apple.com.cn/shop/*",
        "https://www.apple.com/hk-zh/shop/*",
        "https://www.apple.com/tw/shop/*",
        "https://www.apple.com/jp/shop/*",
        "https://www.apple.com/sg/shop/*",
        "https://www.apple.com/au/shop/*",
        "https://www.apple.com/my/shop/*",
        "https://*.store.apple.com/*",
        "https://*.store.apple.com.cn/*"
      ],
      "js": ["core.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Apple Pickup Watcher 自动结账助手"
  }
}
